# Backend base URL, including the /api/v1 prefix (see backend/README.md).
# Both values below are the defaults, so a local setup needs no .env file at all.
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
# Socket.IO endpoint: the backend origin, without the /api/v1 path.
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000
# Public variables are baked in at build time; rebuild after changing them. Never put secrets here.

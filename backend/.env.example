# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=5000
# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# --- Database --------------------------------------------------------------
# Matches docker-compose.yml. Change the password for any non-local database.
DATABASE_URL=postgresql://crisislens:crisislens@localhost:5432/crisislens?schema=public

# --- Auth ------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Must be at least 32 characters. Never reuse across environments.
JWT_SECRET=
JWT_EXPIRES_IN=1d
BCRYPT_ROUNDS=12

# --- CORS ------------------------------------------------------------------
# Comma-separated list of allowed browser origins (also used for Socket.IO).
FRONTEND_URL=http://localhost:3000

# --- Rate limiting ---------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
# Stricter limit for /auth/login and /auth/register.
AUTH_RATE_LIMIT_MAX=20

# --- SerpApi (live news discovery) -----------------------------------------
# Get a key at https://serpapi.com. Server-side only; never expose to the browser.
# Free plans have a small monthly quota: each ingestion run costs one search per query.
SERPAPI_API_KEY=
# 0 = manual only (POST /api/v1/ingestion/run). Otherwise run automatically every N minutes.
SERPAPI_POLL_MINUTES=0

# --- OpenStreetMap place search (Nominatim) --------------------------------
# Public server policy: max 1 request/second, identifying User-Agent, no autocomplete.
# The backend enforces the rate and caches results for 24 h. Self-host Nominatim for heavy use.
# NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# NOMINATIM_USER_AGENT=CrisisLens/1.0 (your project name)

# --- Frontend compatibility ------------------------------------------------
# The current frontend has no login UI, so its "enable/disable source" switch
# cannot send a token. Set true to let PATCH /sources/:id work anonymously
# during local development. The server refuses to start with this enabled
# when NODE_ENV=production.
ALLOW_ANONYMOUS_SOURCE_TOGGLE=true

# --- Seeding (optional) ----------------------------------------------------
# `npm run db:seed` creates this admin user when both values are set.
# Wrap the password in double quotes if it contains `#` or spaces, otherwise
# dotenv treats the rest of the line as a comment and silently truncates it.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
